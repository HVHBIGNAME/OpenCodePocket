{
  "name": "opencode-pocket",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your OpenCode workspace, within reach. Android + iOS client and a self-hosted companion bridge.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build && npm run build:bridge",
    "build:web": "tsc --noEmit && vite build",
    "build:bridge": "node scripts/build-bridge.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "native:sync": "npm run build:web && cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "bridge": "tsx packages/bridge/src/cli.ts",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "assets": "node scripts/assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "clsx": "^2.1.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@opencode-ai/plugin": "1.18.34",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": { "xcode": { "uuid": "^11.1.1" } }
}
